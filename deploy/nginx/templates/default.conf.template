map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# Per-visitor limits: the RPC proxy spends our provider quota and the attestor signs on request.
limit_req_zone $binary_remote_addr zone=rpc:10m rate=40r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

# Only the tunnel containers on the stack's private network can reach this server; they send the visitor's address here.
set_real_ip_from 172.16.0.0/12;
real_ip_header CF-Connecting-IP;

server_tokens off;
gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;

# Market app: static files, attestor under /api, RPC provider under /rpc.
server {
  listen 8081;
  root /srv/market;
  index index.html;

  location /api/ {
    limit_req zone=api burst=30 nodelay;
    proxy_pass http://attestor:8787/;
    proxy_read_timeout 30s;
  }

  include /etc/nginx/conf.d/rpc.inc;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}

# Will app: static files and RPC only, it does not use the attestor.
server {
  listen 8082;
  root /srv/will;
  index index.html;

  include /etc/nginx/conf.d/rpc.inc;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
