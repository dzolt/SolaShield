# Same-origin proxy to the RPC provider (HTTP and WebSocket share the endpoint). The provider key lives only in .env on the server.
location = /rpc {
  limit_req zone=rpc burst=80 nodelay;
  client_max_body_size 1m;
  access_log off;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_ssl_server_name on;
  proxy_read_timeout 3600s;
  proxy_pass ${RPC_URL};
}
